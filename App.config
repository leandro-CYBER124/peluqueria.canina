<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- *** CAMBIAR Password por la contraseña de tu MySQL (la misma que usás en Workbench) *** -->
    <add name="cadena_conexion"
         connectionString="Server=localhost;Port=3306;Database=peluqueria_canina;Uid=root;Pwd=TU_CONTRASEÑA;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
